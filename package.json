{
  "name": "frame-camera",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "On-device camera coach for Web, iOS and Android \u2014 Deutsch, English, \ud55c\uad6d\uc5b4",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "python3 serve.py",
    "sync": "cap sync",
    "ios": "cap open ios",
    "android": "cap open android",
    "build:android": "cd android && ./gradlew assembleDebug",
    "check": "node scripts/verify-project.mjs",
    "build": "node scripts/build-native-bridge.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.6.2",
    "@capacitor/android": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "esbuild": "0.27.0"
  },
  "engines": {
    "node": ">=22"
  }
}
